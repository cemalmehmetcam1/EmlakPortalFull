@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow rounded-4">
            <div class="card-body p-4">
                <h3 class="text-center mb-4">Kayıt Ol</h3>
                <div class="mb-3"><label>Ad Soyad</label><input type="text" id="txtFullName" class="form-control" /></div>
                <div class="mb-3"><label>Kullanıcı Adı</label><input type="text" id="txtUserName" class="form-control" /></div>
                <div class="mb-3"><label>E-Posta</label><input type="email" id="txtEmail" class="form-control" /></div>
                <div class="mb-3"><label>Telefon Numarası</label><input type="tel" id="txtPhoneNumber" class="form-control" /></div>
                <div class="mb-3"><label>Şifre</label><input type="password" id="txtPassword" class="form-control" /></div>
                <button class="btn btn-success w-100" id="btnRegister">Kayıt Ol</button>
                <div id="divResult" class="mt-3"></div>
                <div class="text-center mt-3"><a href="/Auth/Login">Zaten hesabın var mı? Giriş Yap</a></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#btnRegister").click(function() {
            var btn = $(this).prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i>');
            $.ajax({
                url: "https://localhost:7279/api/Auth/Register",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    FullName: $("#txtFullName").val(),
                    UserName: $("#txtUserName").val(),
                    Email: $("#txtEmail").val(),
                    PhoneNumber: $("#txtPhoneNumber").val(),
                    Password: $("#txtPassword").val()
                }),
                success: function(res) {
                    if (res.status) {
                        $("#divResult").html('<div class="alert alert-success">Kayıt başarılı! Giriş sayfasına yönlendiriliyorsunuz...</div>');
                        setTimeout(function() { window.location.href = "/Auth/Login"; }, 1500);
                    } else {
                        $("#divResult").html('<div class="alert alert-danger">'+ res.message +'</div>');
                        btn.prop("disabled", false).html('Kayıt Ol');
                    }
                },
                error: function() { $("#divResult").html('<div class="alert alert-danger">Sunucu hatası!</div>'); btn.prop("disabled", false).html('Kayıt Ol'); }
            });
        });
    </script>
}