@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Dashboard";
}
<div class="row">
    <div class="col-md-3 mb-3"><div class="card text-white bg-primary"><div class="card-body"><h5 id="totalEstates">—</h5><small>Toplam İlan</small></div></div></div>
    <div class="col-md-3 mb-3"><div class="card text-white bg-success"><div class="card-body"><h5 id="activeEstates">—</h5><small>Aktif İlan</small></div></div></div>
    <div class="col-md-3 mb-3"><div class="card text-white bg-info"><div class="card-body"><h5 id="totalUsers">—</h5><small>Kullanıcı</small></div></div></div>
    <div class="col-md-3 mb-3"><div class="card text-white bg-warning"><div class="card-body"><h5 id="totalCategories">—</h5><small>Kategori</small></div></div></div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-list me-2"></i>Son Eklenen İlanlar</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm table-hover" id="tblLatest">
                    <thead>
                        <tr><th>Başlık</th><th>Şehir</th><th>Fiyat</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Şehir Dağılımı</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm table-hover" id="tblCityStats">
                    <thead>
                        <tr><th>Şehir</th><th>İlan Sayısı</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            var token = localStorage.getItem("token");
            if (!token) {
                window.location.href = "/Auth/Login";
                return;
            }

            // Tek API çağrısı ile tüm dashboard verisini al
            $.ajax({
                url: "https://localhost:7279/api/Admin/Dashboard",
                type: "GET",
                headers: { "Authorization": "Bearer " + token },
                success: function(data) {
                    // Üst kartları doldur
                    $("#totalEstates").text(data.totalEstates);
                    $("#activeEstates").text(data.activeEstates);
                    $("#totalUsers").text(data.totalUsers);
                    $("#totalCategories").text(data.totalCategories);

                    // Son eklenen ilanlar tablosu
                    var latestHtml = "";
                    if (data.latestEstates && data.latestEstates.length > 0) {
                        $.each(data.latestEstates, function(i, item) {
                            latestHtml += `<tr>
                                <td>${item.title}</td>
                                <td>${item.city}</td>
                                <td>${item.price.toLocaleString('tr-TR')} ₺</td>
                            </tr>`;
                        });
                    } else {
                        latestHtml = '<tr><td colspan="3" class="text-center">Henüz ilan eklenmemiş.</td></tr>';
                    }
                    $("#tblLatest tbody").html(latestHtml);

                    // Şehir dağılımı tablosu
                    var cityHtml = "";
                    if (data.cityStats && data.cityStats.length > 0) {
                        $.each(data.cityStats, function(i, item) {
                            cityHtml += `<tr>
                                <td>${item.city}</td>
                                <td><span class="badge bg-primary">${item.count}</span></td>
                            </tr>`;
                        });
                    } else {
                        cityHtml = '<tr><td colspan="2" class="text-center">Veri bulunamadı.</td></tr>';
                    }
                    $("#tblCityStats tbody").html(cityHtml);
                },
                error: function() {
                    alert("Dashboard verisi alınamadı. Lütfen sayfayı yenileyin.");
                }
            });
        });
    </script>
}