@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow rounded-4">
            <div class="card-body p-4">
                <h3 class="text-center mb-4">Şifremi Unuttum</h3>
                <div class="mb-3"><label>E-Posta</label><input id="txtEmail" class="form-control" /></div>
                <button class="btn btn-warning w-100" id="btnForgot">Gönder</button>
                <div id="divResult" class="mt-3"></div>
                <div class="text-center mt-3"><a href="/Auth/Login">Giriş Yap</a></div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function(){
        $("#btnForgot").click(function(){
            $.ajax({
                url: "https://localhost:7279/api/Auth/ForgotPassword",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ Email: $("#txtEmail").val() }),
                success: function(res) {
                    $("#divResult").html('<div class="alert alert-info">'+ (res.message || res.Message) +'</div>');
                }
            });
        });
    });
</script>