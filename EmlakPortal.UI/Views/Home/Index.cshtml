@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    ViewData["Title"] = "Emlak İlanları";
}
<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Güncel İlanlar</h3>
        <button class="btn btn-success" id="btnAddEstatePublic" style="display:none;">
            <i class="fas fa-plus me-1"></i> İlan Ver
        </button>
    </div>


    <div class="row mb-4">
        <div class="col-md-3"><input id="txtCity" class="form-control" placeholder="Şehir" /></div>
        <div class="col-md-2"><input id="txtMinPrice" class="form-control" placeholder="Min Fiyat" type="number" /></div>
        <div class="col-md-2"><input id="txtMaxPrice" class="form-control" placeholder="Max Fiyat" type="number" /></div>
        <div class="col-md-2">
            <select id="cmbStatus" class="form-control"><option value="">Tümü</option><option value="1">Satılık</option><option value="2">Kiralık</option></select>
        </div>
        <div class="col-md-1"><button id="btnFilter" class="btn btn-primary">Filtrele</button></div>
    </div>
    <div id="estateList" class="row"></div>
</div>


<div class="modal fade" id="publicEstateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Yeni İlan Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnPublicEstateId" value="0" />
                <div class="row g-2">
                    <div class="col-md-6 mb-2"><label>Başlık</label><input id="txtPublicTitle" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>Fiyat (₺)</label><input id="txtPublicPrice" type="number" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>Oda Sayısı</label><input id="txtPublicRoomCount" type="number" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>m²</label><input id="txtPublicSquareMeters" type="number" class="form-control" /></div>
                    <div class="col-md-3 mb-2">
                        <label>Şehir</label>
                        <select id="cmbPublicCity" class="form-control">
                            <option value="">Seçiniz</option>
                            <option value="Adana">Adana</option>

                        </select>
                    </div>
                    <div class="col-md-6 mb-2"><label>Adres</label><input id="txtPublicAddress" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>Durum</label><select id="cmbPublicStatus" class="form-control"><option value="1">Satılık</option><option value="2">Kiralık</option></select></div>
                    <div class="col-md-3 mb-2"><label>Kategori</label><select id="cmbPublicCategory" class="form-control"></select></div>
                    <div class="col-md-12 mb-2"><label>Açıklama</label><textarea id="txtPublicDescription" class="form-control" rows="2"></textarea></div>
                    <div class="col-md-6 mb-2"><label>Aktif</label><select id="cmbPublicIsActive" class="form-control"><option value="true">Evet</option><option value="false">Hayır</option></select></div>
                    <div class="col-md-6 mb-2">
                        <label>Vitrin Fotoğrafı</label>
                        <input type="file" id="filePublicImage" class="form-control" accept="image/*" />
                        <div class="mt-2"><img id="imgPublicPreview" src="" style="max-height:100px; display:none;" class="rounded shadow-sm" /></div>
                    </div>
                    <div class="col-md-12 mb-2">
                        <label>Galeri Fotoğrafları (isteğe bağlı)</label>
                        <input type="file" id="filePublicImages" class="form-control" accept="image/*" multiple />
                        <div class="mt-2" id="galleryPublicPreview" style="display:flex; flex-wrap:wrap; gap:5px;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="btnSavePublic">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var token = localStorage.getItem("token");
        if (token) {
            $("#btnAddEstatePublic").show();
        }

        function getHeaders() { return { "Authorization": "Bearer " + token }; }

        function loadEstates(filters = {}) {
            $.ajax({
                url: "https://localhost:7279/api/Estate/Filter",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(filters),
                success: function (data) {
                    var html = "";
                    if (data.length === 0) html = '<div class="col-12 text-center">İlan bulunamadı.</div>';
                    $.each(data, function (i, item) {
                        html += `<div class="col-md-4 mb-4">
                            <div class="card h-100 position-relative">
                                <button class="btn btn-link position-absolute top-0 end-0 m-2 p-0 btn-fav"
                                        data-id="${item.id}" style="z-index:10; font-size:1.5rem; color:red; text-decoration:none;"
                                        title="Favorilere ekle / çıkar">
                                    <i class="far fa-heart"></i>
                                </button>
                                <div style="position: relative;">
                                    <img src="${item.imageUrl ? 'https://localhost:7279' + item.imageUrl : 'https://localhost:7279/images/default.jpg'}" class="card-img-top" style="height:200px; object-fit:cover" />`;
                        if (item.imageUrls && item.imageUrls.length > 1) {
                            html += `<span class="badge bg-dark position-absolute bottom-0 end-0 m-2">${item.imageUrls.length} fotoğraf</span>`;
                        }
                        html += `</div>
                                <div class="card-body">
                                    <h5 class="card-title">${item.title}</h5>
                                    <p>${item.price.toLocaleString('tr-TR')} TL</p>
                                    <p>${item.roomCount} Oda - ${item.squareMeters} m²</p>
                                    <p>${item.statusName}</p>
                                    <a href="/Home/Detail/${item.id}" class="btn btn-primary">Detay</a>
                                </div>
                            </div>
                        </div>`;
                    });
                    $("#estateList").html(html);
                    updateFavButtons();
                }
            });
        }

        function loadCategories() {
            $.ajax({ url: "https://localhost:7279/api/Category", success: function(d) {
                var opts = "";
                $.each(d, function(i,c) { opts += `<option value="${c.id}">${c.name}</option>`; });
                $("#cmbPublicCategory").html(opts);
            }});
        }


        function updateFavButtons() {
            if (!token) return;
            $.ajax({
                url: "https://localhost:7279/api/Favorite",
                headers: getHeaders(),
                success: function(favs) {
                    $(".btn-fav").each(function(){
                        var id = $(this).data("id");
                        var isFav = favs.some(f => f.id == id);
                        $(this).html(isFav ? '<i class="fas fa-heart"></i>' : '<i class="far fa-heart"></i>');
                    });
                }
            });
        }

        $(document).on("click", ".btn-fav", function(e){
            e.preventDefault();
            if (!token) { alert("Favorilere eklemek için giriş yapmalısınız."); return; }
            var id = $(this).data("id");
            var btn = $(this);
            $.ajax({
                url: "https://localhost:7279/api/Favorite/Toggle/" + id,
                type: "POST",
                headers: getHeaders(),
                success: function(res) {
                    if (res.status) {
                        var isFav = res.data;
                        btn.html(isFav ? '<i class="fas fa-heart"></i>' : '<i class="far fa-heart"></i>');
                    }
                }
            });
        });


        $("#btnAddEstatePublic").click(function(){
            $("#publicEstateModal").modal("show");
        });

        $("#btnSavePublic").click(function(){
            var payload = {
                Title: $("#txtPublicTitle").val(),
                Price: parseFloat($("#txtPublicPrice").val()),
                RoomCount: parseInt($("#txtPublicRoomCount").val()),
                SquareMeters: parseInt($("#txtPublicSquareMeters").val()),
                City: $("#cmbPublicCity").val(),
                Address: $("#txtPublicAddress").val(),
                Status: parseInt($("#cmbPublicStatus").val()),
                CategoryId: parseInt($("#cmbPublicCategory").val()),
                Description: $("#txtPublicDescription").val(),
                IsActive: $("#cmbPublicIsActive").val() === "true"
            };

            $.ajax({
                url: "https://localhost:7279/api/Estate",
                type: "POST",
                contentType: "application/json",
                headers: getHeaders(),
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.status) {
                        var newId = res.data;

                        alert("İlan başarıyla eklendi.");
                        $("#publicEstateModal").modal("hide");
                        loadEstates();
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

        $(function () {
            loadEstates();
            loadCategories();

            $("#btnFilter").click(function () {
                var filter = {
                    City: $("#txtCity").val() || null,
                    MinPrice: $("#txtMinPrice").val() ? parseFloat($("#txtMinPrice").val()) : null,
                    MaxPrice: $("#txtMaxPrice").val() ? parseFloat($("#txtMaxPrice").val()) : null,
                    Status: $("#cmbStatus").val() ? parseInt($("#cmbStatus").val()) : null,
                    RoomCount: null
                };
                loadEstates(filter);
            });


            $("#filePublicImage").change(function(){
                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) { $("#imgPublicPreview").attr("src", e.target.result).show(); };
                    reader.readAsDataURL(file);
                } else { $("#imgPublicPreview").hide(); }
            });
            $("#filePublicImages").change(function(){
                var files = this.files;
                $("#galleryPublicPreview").empty();
                for (var i = 0; i < files.length; i++) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $("#galleryPublicPreview").append('<img src="' + e.target.result + '" style="height:60px; margin:2px;" class="rounded shadow-sm" />');
                    };
                    reader.readAsDataURL(files[i]);
                }
            });
        });
    </script>
}