@{
    ViewData["Title"] = "Profilim";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded-4">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4">Profil Bilgileri</h3>
                    <div id="profileInfo">
                        <p><strong>Kullanıcı Adı:</strong> <span id="lblUserName">—</span></p>
                        <p><strong>Ad Soyad:</strong> <span id="lblFullName">—</span></p>
                        <p><strong>E-posta:</strong> <span id="lblEmail">—</span></p>
                        <p><strong>Telefon:</strong> <span id="lblPhone">—</span></p>
                        <p><strong>Rol:</strong> <span id="lblRole" class="badge bg-secondary">—</span></p>
                    </div>
                    <hr />
                    <h5 class="mb-3">Bilgileri Güncelle</h5>
                    <div class="mb-3">
                        <label>Ad Soyad</label>
                        <input type="text" id="txtFullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>E-posta</label>
                        <input type="email" id="txtEmail" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Telefon Numarası</label>
                        <input type="tel" id="txtPhoneNumber" class="form-control" placeholder="05XX XXX XX XX" />
                    </div>
                    <div class="mb-3">
                        <label>Mevcut Şifre (değiştirmek istemiyorsanız boş bırakın)</label>
                        <input type="password" id="txtCurrentPassword" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Yeni Şifre</label>
                        <input type="password" id="txtNewPassword" class="form-control" />
                    </div>
                    <button class="btn btn-primary w-100" id="btnUpdateProfile">Güncelle</button>
                    <div id="divResult" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var token = localStorage.getItem("token");
        if (!token) { window.location.href = "/Auth/Login"; }

        function getHeaders() { return { "Authorization": "Bearer " + token }; }

        // Profil bilgilerini getir
        $.ajax({
            url: "https://localhost:7279/api/Auth/GetProfile",
            type: "GET",
            headers: getHeaders(),
            success: function(res) {
                if (res.status) {
                    var user = res.data;
                    $("#lblUserName").text(user.userName);
                    $("#lblFullName").text(user.fullName);
                    $("#lblEmail").text(user.email);
                    $("#lblPhone").text(user.phoneNumber || "Belirtilmemiş");
                    $("#lblRole").text(user.role).addClass(user.role === "Admin" ? "bg-danger" : "bg-secondary");
                    $("#txtFullName").val(user.fullName);
                    $("#txtEmail").val(user.email);
                    $("#txtPhoneNumber").val(user.phoneNumber || "");
                }
            },
            error: function(xhr) {
                if (xhr.status === 401) window.location.href = "/Auth/Login";
            }
        });

        // Güncelle
        $("#btnUpdateProfile").click(function() {
            var payload = {
                FullName: $("#txtFullName").val(),
                Email: $("#txtEmail").val(),
                PhoneNumber: $("#txtPhoneNumber").val(),
                CurrentPassword: $("#txtCurrentPassword").val(),
                NewPassword: $("#txtNewPassword").val()
            };

            var btn = $(this).prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> Güncelleniyor...');
            $.ajax({
                url: "https://localhost:7279/api/Auth/UpdateProfile",
                type: "PUT",
                contentType: "application/json",
                headers: getHeaders(),
                data: JSON.stringify(payload),
                success: function(res) {
                    btn.prop("disabled", false).html('Güncelle');
                    if (res.status) {
                        $("#divResult").html('<div class="alert alert-success">Profil güncellendi.</div>');
                        $("#lblFullName").text(payload.FullName);
                        $("#lblEmail").text(payload.Email);
                        $("#lblPhone").text(payload.PhoneNumber || "Belirtilmemiş");
                    } else {
                        $("#divResult").html('<div class="alert alert-danger">' + (res.message || res.Message) + '</div>');
                    }
                },
                error: function() {
                    btn.prop("disabled", false).html('Güncelle');
                    $("#divResult").html('<div class="alert alert-danger">Bir hata oluştu.</div>');
                }
            });
        });
    </script>
}