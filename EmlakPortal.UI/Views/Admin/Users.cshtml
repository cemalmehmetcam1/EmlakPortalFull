@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Kullanıcı Yönetimi";
}
<table class="table table-bordered" id="tblUsers">
    <thead class="table-light">
        <tr><th>Kullanıcı Adı</th><th>Ad Soyad</th><th>E-posta</th><th>Yetki</th><th style="width:100px;">İşlem</th></tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script>
        var token = localStorage.getItem("token");
        function getHeaders() { return { "Authorization": "Bearer " + token }; }

        function loadUsers() {
            $.ajax({
                url: "https://localhost:7279/api/Auth/Users",
                headers: getHeaders(),
                success: function(users) {
                    var rows = "";
                    $.each(users, function(i, u) {
                        var isAdmin = u.roles && u.roles.includes("Admin");
                        rows += `<tr>
                            <td>${u.userName}</td><td>${u.fullName}</td><td>${u.email}</td>
                            <td><span class="badge ${isAdmin ? 'bg-danger' : 'bg-secondary'}">${isAdmin ? 'Admin' : 'User'}</span></td>
                            <td>
                                ${isAdmin
                                    ? `<button class="btn btn-sm btn-outline-danger btnRole" data-user="${u.userName}" data-role="revoke">Yetki Al</button>`
                                    : `<button class="btn btn-sm btn-outline-success btnRole" data-user="${u.userName}" data-role="make">Admin Yap</button>`}
                            </td>
                        </tr>`;
                    });
                    $("#tblUsers tbody").html(rows);
                }
            });
        }

        $(function() {
            loadUsers();
            $(document).on("click", ".btnRole", function(){
                var userName = $(this).data("user");
                var action = $(this).data("role");
                var url = action === "make" ? "https://localhost:7279/api/Auth/MakeAdmin?userName=" + userName
                           : "https://localhost:7279/api/Auth/RevokeAdmin?userName=" + userName;
                $.ajax({
                    url: url,
                    type: "POST",
                    headers: getHeaders(),
                    success: function(res) { alert(res.message); loadUsers(); },
                    error: function() { alert("İşlem başarısız."); }
                });
            });
        });
    </script>
}