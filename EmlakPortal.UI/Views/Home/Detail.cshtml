@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    ViewData["Title"] = "İlan Detayı";
}
<div id="detailContainer" class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div id="detailContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        var id = window.location.pathname.split('/').pop();
        $(function() {
            $.ajax({
                url: "https://localhost:7279/api/Estate/" + id,
                success: function(item) {
                    var html = `
                        <div class="card shadow rounded-4">
                           <img src="${item.imageUrl ? 'https://localhost:7279' + item.imageUrl : 'https://localhost:7279/images/default.jpg'}" class="card-img-top" style="max-height:400px;object-fit:cover;" />
                            <div class="card-body">
                                <h2>${item.title}</h2>
                                <p>${item.description || ''}</p>
                                <h4 class="text-primary">${item.price.toLocaleString('tr-TR')} ₺</h4>
                                <p><strong>Oda:</strong> ${item.roomCount} | <strong>m²:</strong> ${item.squareMeters} | <strong>Şehir:</strong> ${item.city}</p>
                                <p><strong>Durum:</strong> ${item.statusName} | <strong>Kategori:</strong> ${item.categoryName} | <strong>Ekleyen:</strong> ${item.addedBy}</p>
                            </div>
                        </div>`;
                    $("#detailContent").html(html);
                }
            });
        });
    </script>
}