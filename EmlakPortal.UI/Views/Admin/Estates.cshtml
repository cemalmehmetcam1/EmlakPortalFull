@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "İlan Yönetimi";
}
<div class="container-fluid">
    <button class="btn btn-success mb-3" id="btnAddNew"><i class="fas fa-plus me-1"></i> Yeni İlan Ekle</button>
    <div class="table-responsive">
        <table class="table table-bordered table-hover" id="tblEstates">
            <thead class="table-light">
                <tr><th>Başlık</th><th>Fiyat</th><th>Şehir</th><th>Durum</th><th style="width:180px;">İşlem</th></tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>


<div class="modal fade" id="estateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Yeni İlan Ekle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnEstateId" value="0" />
                <div class="row g-2">
                    <div class="col-md-6 mb-2"><label>Başlık</label><input id="txtTitle" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>Fiyat (₺)</label><input id="txtPrice" type="number" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>Oda Sayısı</label><input id="txtRoomCount" type="number" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>m²</label><input id="txtSquareMeters" type="number" class="form-control" /></div>
                    <div class="col-md-3 mb-2">
                        <label>Şehir</label>
                        <select id="cmbCity" class="form-control">
                            <option value="">Seçiniz</option>
                            <option value="Adana">Adana</option>
                            <option value="Adıyaman">Adıyaman</option>
                            <option value="Afyonkarahisar">Afyonkarahisar</option>
                            <option value="Ağrı">Ağrı</option>
                            <option value="Amasya">Amasya</option>
                            <option value="Ankara">Ankara</option>
                            <option value="Antalya">Antalya</option>
                            <option value="Artvin">Artvin</option>
                            <option value="Aydın">Aydın</option>
                            <option value="Balıkesir">Balıkesir</option>
                            <option value="Bilecik">Bilecik</option>
                            <option value="Bingöl">Bingöl</option>
                            <option value="Bitlis">Bitlis</option>
                            <option value="Bolu">Bolu</option>
                            <option value="Burdur">Burdur</option>
                            <option value="Bursa">Bursa</option>
                            <option value="Çanakkale">Çanakkale</option>
                            <option value="Çankırı">Çankırı</option>
                            <option value="Çorum">Çorum</option>
                            <option value="Denizli">Denizli</option>
                            <option value="Diyarbakır">Diyarbakır</option>
                            <option value="Edirne">Edirne</option>
                            <option value="Elazığ">Elazığ</option>
                            <option value="Erzincan">Erzincan</option>
                            <option value="Erzurum">Erzurum</option>
                            <option value="Eskişehir">Eskişehir</option>
                            <option value="Gaziantep">Gaziantep</option>
                            <option value="Giresun">Giresun</option>
                            <option value="Gümüşhane">Gümüşhane</option>
                            <option value="Hakkari">Hakkari</option>
                            <option value="Hatay">Hatay</option>
                            <option value="Isparta">Isparta</option>
                            <option value="Mersin">Mersin</option>
                            <option value="İstanbul">İstanbul</option>
                            <option value="İzmir">İzmir</option>
                            <option value="Kars">Kars</option>
                            <option value="Kastamonu">Kastamonu</option>
                            <option value="Kayseri">Kayseri</option>
                            <option value="Kırklareli">Kırklareli</option>
                            <option value="Kırşehir">Kırşehir</option>
                            <option value="Kocaeli">Kocaeli</option>
                            <option value="Konya">Konya</option>
                            <option value="Kütahya">Kütahya</option>
                            <option value="Malatya">Malatya</option>
                            <option value="Manisa">Manisa</option>
                            <option value="Kahramanmaraş">Kahramanmaraş</option>
                            <option value="Mardin">Mardin</option>
                            <option value="Muğla">Muğla</option>
                            <option value="Muş">Muş</option>
                            <option value="Nevşehir">Nevşehir</option>
                            <option value="Niğde">Niğde</option>
                            <option value="Ordu">Ordu</option>
                            <option value="Rize">Rize</option>
                            <option value="Sakarya">Sakarya</option>
                            <option value="Samsun">Samsun</option>
                            <option value="Siirt">Siirt</option>
                            <option value="Sinop">Sinop</option>
                            <option value="Sivas">Sivas</option>
                            <option value="Tekirdağ">Tekirdağ</option>
                            <option value="Tokat">Tokat</option>
                            <option value="Trabzon">Trabzon</option>
                            <option value="Tunceli">Tunceli</option>
                            <option value="Şanlıurfa">Şanlıurfa</option>
                            <option value="Uşak">Uşak</option>
                            <option value="Van">Van</option>
                            <option value="Yozgat">Yozgat</option>
                            <option value="Zonguldak">Zonguldak</option>
                            <option value="Aksaray">Aksaray</option>
                            <option value="Bayburt">Bayburt</option>
                            <option value="Karaman">Karaman</option>
                            <option value="Kırıkkale">Kırıkkale</option>
                            <option value="Batman">Batman</option>
                            <option value="Şırnak">Şırnak</option>
                            <option value="Bartın">Bartın</option>
                            <option value="Ardahan">Ardahan</option>
                            <option value="Iğdır">Iğdır</option>
                            <option value="Yalova">Yalova</option>
                            <option value="Karabük">Karabük</option>
                            <option value="Kilis">Kilis</option>
                            <option value="Osmaniye">Osmaniye</option>
                            <option value="Düzce">Düzce</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-2"><label>Adres</label><input id="txtAddress" class="form-control" /></div>
                    <div class="col-md-3 mb-2"><label>Durum</label><select id="cmbStatus" class="form-control"><option value="1">Satılık</option><option value="2">Kiralık</option></select></div>
                    <div class="col-md-3 mb-2"><label>Kategori</label><select id="cmbCategory" class="form-control"></select></div>
                    <div class="col-md-12 mb-2"><label>Açıklama</label><textarea id="txtDescription" class="form-control" rows="2"></textarea></div>
                    <div class="col-md-6 mb-2"><label>Aktif</label><select id="cmbIsActive" class="form-control"><option value="true">Evet</option><option value="false">Hayır</option></select></div>
                    <div class="col-md-6 mb-2">
                        <label>Vitrin Fotoğrafı</label>
                        <input type="file" id="fileImage" class="form-control" accept="image/*" />
                        <input type="hidden" id="hdnImageUrl" />
                        <div class="mt-2">
                            <img id="imgPreview" src="" style="max-height:100px; display:none;" class="rounded shadow-sm" />
                        </div>
                    </div>

                    <div class="col-md-12 mb-2">
                        <label>Galeri Fotoğrafları (isteğe bağlı, birden fazla seçin)</label>
                        <input type="file" id="fileImages" class="form-control" accept="image/*" multiple />
                        <div class="mt-2" id="galleryPreview" style="display:flex; flex-wrap:wrap; gap:5px;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="btnSave">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var token = localStorage.getItem("token");
        function getHeaders() { return { "Authorization": "Bearer " + token }; }

        function loadEstates() {
            $.ajax({
                url: "https://localhost:7279/api/Estate",
                success: function (data) {
                    var rows = "";
                    $.each(data, function (i, item) {
                        rows += `<tr>
                                    <td>${item.title}</td>
                                    <td>${item.price.toLocaleString('tr-TR')} ₺</td>
                                    <td>${item.city}</td>
                                    <td><span class="badge ${item.isActive ? 'bg-success' : 'bg-secondary'}">${item.isActive ? 'Aktif' : 'Pasif'}</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-warning btnEdit" data-id="${item.id}"><i class="fas fa-pen"></i></button>
                                        <button class="btn btn-sm btn-danger btnDelete" data-id="${item.id}"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>`;
                    });
                    $("#tblEstates tbody").html(rows);
                }
            });
        }

        function loadCategories() {
            $.ajax({ url: "https://localhost:7279/api/Category", success: function(d) {
                var opts = "";
                $.each(d, function(i,c) { opts += `<option value="${c.id}">${c.name}</option>`; });
                $("#cmbCategory").html(opts);
            }});
        }

        $(function () {
            loadEstates();
            loadCategories();


            $("#fileImage").change(function(){
                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $("#imgPreview").attr("src", e.target.result).show();
                    };
                    reader.readAsDataURL(file);
                } else {
                    $("#imgPreview").hide();
                }
            });

           
            $("#fileImages").change(function(){
                var files = this.files;
                
                console.log("Seçilen galeri dosyaları:", files);
            });

            $("#btnAddNew").click(function(){
                $("#modalTitle").text("Yeni İlan Ekle");
                $("#hdnEstateId").val("0");
                $("#txtTitle, #txtPrice, #txtRoomCount, #txtSquareMeters, #txtAddress, #txtDescription").val("");
                $("#cmbCity").val("");
                $("#cmbStatus").val("1");
                $("#cmbIsActive").val("true");
                $("#fileImage").val("");
                $("#hdnImageUrl").val("");
                $("#imgPreview").hide();
                $("#fileImages").val("");
                $("#galleryPreview").empty();
                $("#estateModal").modal("show");
            });


            $("#btnSave").click(function(){
                var id = parseInt($("#hdnEstateId").val());
                var isNew = id === 0;
                var url = "https://localhost:7279/api/Estate";
                var type = isNew ? "POST" : "PUT";

                var payload = {
                    Title: $("#txtTitle").val(),
                    Price: parseFloat($("#txtPrice").val()),
                    RoomCount: parseInt($("#txtRoomCount").val()),
                    SquareMeters: parseInt($("#txtSquareMeters").val()),
                    City: $("#cmbCity").val(),
                    Address: $("#txtAddress").val(),
                    Status: parseInt($("#cmbStatus").val()),
                    CategoryId: parseInt($("#cmbCategory").val()),
                    Description: $("#txtDescription").val(),
                    IsActive: $("#cmbIsActive").val() === "true"
                };
                if (!isNew) payload.Id = id;

                $.ajax({
                    url: url, type: type, contentType: "application/json",
                    headers: getHeaders(),
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res.status || res.Status) {
                            var newId = res.data || res.id || id;
                            if (!newId || newId === 0) {
                                alert("İlan kaydedildi ancak ID alınamadı. Lütfen sayfayı yenileyin.");
                                $("#estateModal").modal("hide");
                                loadEstates();
                                return;
                            }

                            var uploadPromises = [];


                            if ($("#fileImage")[0].files[0]) {
                                var formData = new FormData();
                                formData.append("file", $("#fileImage")[0].files[0]);
                                uploadPromises.push(
                                    $.ajax({
                                        url: "https://localhost:7279/api/Estate/" + newId + "/ImageUpload",
                                        type: "POST",
                                        headers: getHeaders(),
                                        processData: false,
                                        contentType: false,
                                        data: formData
                                    })
                                );
                            }

  
                            if ($("#fileImages")[0].files.length > 0) {
                                var galleryFormData = new FormData();
                                var files = $("#fileImages")[0].files;
                                for (var i = 0; i < files.length; i++) {
                                    galleryFormData.append("files", files[i]);
                                }
                                uploadPromises.push(
                                    $.ajax({
                                        url: "https://localhost:7279/api/Estate/" + newId + "/UploadImages",
                                        type: "POST",
                                        headers: getHeaders(),
                                        processData: false,
                                        contentType: false,
                                        data: galleryFormData
                                    })
                                );
                            }

                            $.when.apply($, uploadPromises)
                                .done(function() {
                                    alert("İlan ve fotoğraflar başarıyla kaydedildi.");
                                })
                                .fail(function(xhr, status, error) {
                                    alert("Fotoğraf yükleme sırasında bir hata oluştu. Lütfen kontrol edin.");
                                    console.error("Yükleme hatası:", status, error);
                                })
                                .always(function() {
                                    $("#estateModal").modal("hide");
                                    loadEstates();
                                });

                        } else {
                            alert(res.message || res.Message);
                        }
                    },
                    error: function(xhr, status, error) {
                        alert("Kaydetme sırasında bir hata oluştu.");
                        console.error("Kaydetme hatası:", status, error);
                    }
                });
            });


            $(document).on("click", ".btnEdit", function(){
                var id = $(this).data("id");
                $.ajax({
                    url: "https://localhost:7279/api/Estate/" + id,
                    success: function(item) {
                        $("#hdnEstateId").val(item.id);
                        $("#txtTitle").val(item.title);
                        $("#txtPrice").val(item.price);
                        $("#txtRoomCount").val(item.roomCount);
                        $("#txtSquareMeters").val(item.squareMeters);
                        $("#cmbCity").val(item.city);
                        $("#txtAddress").val(item.address);
                        $("#cmbStatus").val(item.statusName === "Satılık" ? "1" : "2");
                        $("#cmbCategory").val(item.categoryId);
                        $("#txtDescription").val(item.description || "");
                        $("#cmbIsActive").val(item.isActive ? "true" : "false");
                        $("#hdnImageUrl").val(item.imageUrl || "");
                        if (item.imageUrl) {
                            $("#imgPreview").attr("src", "https://localhost:7279" + item.imageUrl).show();
                        } else {
                            $("#imgPreview").hide();
                        }

                        $("#galleryPreview").empty();
                        if (item.imageUrls && item.imageUrls.length > 0) {
                            $.each(item.imageUrls, function(i, url){
                                var imageId = item.imageIds[i];
                                var imgHtml = `
                                    <div class="position-relative" style="display:inline-block; margin:2px;">
                                        <img src="https://localhost:7279${url}" style="height:60px;" class="rounded shadow-sm" />
                                        <span class="badge bg-danger position-absolute top-0 end-0 btn-delete-gallery-image"
                                              style="cursor:pointer; font-size:14px; padding:2px 6px; border-radius:50%;"
                                              data-imageid="${imageId}"
                                              title="Fotoğrafı sil">×</span>
                                    </div>`;
                                $("#galleryPreview").append(imgHtml);
                            });
                        }


                        $("#fileImage").val("");
                        $("#fileImages").val("");
                        $("#modalTitle").text("İlan Düzenle");
                        $("#estateModal").modal("show");
                    }
                });
            });


            $(document).on("click", ".btn-delete-gallery-image", function(e){
                e.preventDefault();
                var imageId = $(this).data("imageid");
                var container = $(this).closest("div.position-relative");

                if (!confirm("Bu fotoğrafı silmek istediğinize emin misiniz?")) return;

                $.ajax({
                    url: "https://localhost:7279/api/Estate/Image/" + imageId,
                    type: "DELETE",
                    headers: getHeaders(),
                    success: function(res) {
                        if (res.status || res.Status) {
                            container.remove(); 
                            alert("Fotoğraf silindi.");
                        } else {
                            alert(res.message || res.Message || "Silme başarısız.");
                        }
                    },
                    error: function() {
                        alert("Silme sırasında hata oluştu.");
                    }
                });
            });

    
            $(document).on("click", ".btnDelete", function(){
                if (!confirm("Bu ilanı silmek istediğinize emin misiniz?")) return;
                var id = $(this).data("id");
                $.ajax({
                    url: "https://localhost:7279/api/Estate/" + id,
                    type: "DELETE", headers: getHeaders(),
                    success: function() { loadEstates(); }
                });
            });
        });
    </script>
}