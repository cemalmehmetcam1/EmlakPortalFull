<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Emlak Portalı</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        body {
            background: #f8f9fc;
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar-custom {
            background: #2c3e50;
            padding: 0.4rem 0;
        }

            .navbar-custom .navbar-brand {
                color: white;
                font-weight: bold;
            }

            .navbar-custom .nav-link {
                color: rgba(255,255,255,.8);
                margin: 0 0.3rem;
                border-radius: 8px;
                padding: 0.4rem 1rem;
            }

                .navbar-custom .nav-link:hover {
                    background: rgba(255,255,255,.1);
                    color: white;
                }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="/"><i class="fas fa-building me-2"></i>Emlak Portalı</a>
            <div class="navbar-nav ms-auto" id="navAuthLinks">
                <!-- Giriş yapmamış kullanıcı -->
                <a class="nav-link" href="/Home/Index"><i class="fas fa-search me-1"></i>İlan Ara</a>
                <a class="nav-link" href="/Auth/Login"><i class="fas fa-sign-in-alt me-1"></i>Giriş</a>
                <a class="nav-link" href="/Auth/Register"><i class="fas fa-user-plus me-1"></i>Kayıt</a>
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        @RenderBody()
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function parseJwt(token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            return JSON.parse(decodeURIComponent(window.atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
        }

        $(function() {
            var token = localStorage.getItem("token");
            var menu = $("#navMenu");

            if (token) {
                var payload = parseJwt(token);
                var role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"];
                var userName = payload["FullName"] || payload["unique_name"] || "Kullanıcı";

                var html = `
                    <span class="text-white me-3">Hoş geldin, ${userName}</span>
                    <a class="nav-link" href="/Home/Index"><i class="fas fa-search me-1"></i>İlan Ara</a>`;

                if (role === "Admin") {
                    html += `<a class="nav-link" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt me-1"></i>Yönetim</a>`;
                }

                html += `<a class="nav-link" href="#" onclick="logout()"><i class="fas fa-sign-out-alt me-1"></i>Çıkış</a>`;
                menu.html(html);
            } else {
                menu.html(`
                    <a class="nav-link" href="/Home/Index"><i class="fas fa-search me-1"></i>İlan Ara</a>
                    <a class="nav-link" href="/Auth/Login"><i class="fas fa-sign-in-alt me-1"></i>Giriş</a>
                    <a class="nav-link" href="/Auth/Register"><i class="fas fa-user-plus me-1"></i>Kayıt</a>
                `);
            }
        });

        function logout() {
            localStorage.clear();
            window.location.href = "/Auth/Login";
        }
    </script>
    @RenderSection("Scripts", required: false)
    <script>
        $(function () {
            var token = localStorage.getItem("token");
            if (token) {
                try {
                    var payload = parseJwt(token);
                    var userName = payload["FullName"] || payload["unique_name"] || payload["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"] || "Kullanıcı";
                    var isAdmin = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] === "Admin";

                    var linksHtml = '<a class="nav-link" href="/Home/Index"><i class="fas fa-search me-1"></i>İlan Ara</a>';
                    if (isAdmin) {
                        linksHtml += '<a class="nav-link" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt me-1"></i>Yönetim</a>';
                    }
                    linksHtml += '<span class="nav-link text-white">Merhaba, ' + userName + '</span>' +
                        '<a class="nav-link" href="#" id="btnPublicLogout"><i class="fas fa-sign-out-alt me-1"></i>Çıkış</a>';

                    $("#navAuthLinks").html(linksHtml);

                    $("#btnPublicLogout").click(function (e) {
                        e.preventDefault();
                        localStorage.removeItem("token");
                        window.location.href = "/";
                    });
                } catch (e) { }
            }
        });

        function parseJwt(token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            return JSON.parse(decodeURIComponent(window.atob(base64).split('').map(function (c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join('')));
        }
    </script>
</body>
</html>